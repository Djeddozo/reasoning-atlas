{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-manifest.schema.json",
  "title": "Atlas module manifest",
  "description": "Reference schema for modules/*.json (RA-020). The executable validator is packages/contracts/modules.py, which also enforces cross-field rules: capability IDs are '<module>.<domain>.<name>', tested/live need evidence, approval is at least none/confirm/owner for read/propose/act, an L0 app lists only planned capabilities, and tools have no integration level.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "kind",
    "summary",
    "domains",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "platform",
        "app",
        "tool"
      ],
      "description": "platform = Atlas; app = a module kept whole (HQ); tool = an external app the owner can switch to (Claude app, Codex)."
    },
    "integrationLevel": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        null
      ],
      "description": "L0 listed, L1 read, L2 callable, L3 embedded, L4 primary interface. Null for tools."
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "runsOn": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "opens": {
      "type": "string",
      "description": "How the owner opens a tool when Atlas hands work over."
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "summary",
          "effect",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$"
          },
          "domain": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "effect": {
            "enum": [
              "read",
              "propose",
              "act"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "built",
              "tested",
              "live"
            ]
          },
          "approval": {
            "enum": [
              "none",
              "confirm",
              "owner"
            ]
          },
          "intent": {
            "type": "string",
            "description": "What the work is, independent of who does it, for example web.research or code.edit. Used to decide where work runs and when to switch apps."
          },
          "evidence": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "outputs": {
            "type": "object"
          }
        }
      }
    }
  }
}
