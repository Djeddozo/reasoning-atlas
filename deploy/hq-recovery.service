[Unit]
Description=HQ crash recovery and tested bug-fix updates

[Service]
Type=oneshot
WorkingDirectory=%h/hq-system
ExecStart=/bin/bash -c 'set -a; source .env; set +a; exec python3 -m engine.recovery'
Environment=PATH=/home/user/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
TimeoutStartSec=30min
