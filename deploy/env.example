# Copy to ~/hq-system/.env on the Pi (git-ignored) and fill in. Never commit the real file.
HQ_TOKEN=            # dashboard access; created automatically by setup-pi.sh, `hq serve` or `hq link` when empty
HQ_NTFY_TOPIC=       # long random topic name, e.g. hq-<token_urlsafe(12)>; subscribe to it in the ntfy app
ANTHROPIC_API_KEY=   # optional, enables brain-dump extraction and `hq think`
HQ_OLLAMA_URL=       # optional, e.g. http://gpu-pc:11434 once the GPU PC is set up
TELEGRAM_BOT_TOKEN=  # optional, from @BotFather; enables `hq bot` (see README → Telegram)
TELEGRAM_CHAT_ID=    # your own chat id; find it with `./atlas.sh bot --whoami`. All other chats are ignored
HQ_WHISPER_URL=      # optional, Whisper endpoint on the GPU PC for voice notes, e.g. http://gpu-pc:8000
HQ_HOST=             # dashboard address; set to the Pi's Tailscale IP (tailscale ip -4) to open it on your phone
HQ_PORT=8765         # choose a free local port if another app uses 8765
HQ_HTTPS_PORT=443    # HTTPS port for deploy/https-dashboard.sh; choose a free tailnet port

# Private backup (engine/backup.py): an encrypted daily snapshot of the data goes to a separate PRIVATE repository.
# Key: openssl rand -base64 32  (keep a copy somewhere safe; without it a snapshot cannot be restored)
ATLAS_BACKUP_KEY=
ATLAS_BACKUP_REPO=
